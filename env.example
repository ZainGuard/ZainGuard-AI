# ZainGuard AI — Environment Configuration
# Copy this file to .env and fill in your values.
# Only configure the sections for connectors you are actually using.

# =============================================================================
# LLM Provider (required — pick one, or configure multiple for fallback)
# =============================================================================

# Anthropic — recommended (Claude performs best for security reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — optional alternative
OPENAI_API_KEY=your_openai_api_key_here

# Ollama — local models, no key needed, just set the base URL if non-default
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Layer 3 — Threat Intelligence (at least one required for IOC enrichment)
# =============================================================================

VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here

# =============================================================================
# Layer 1 — Security Telemetry (configure for the connectors you enable)
# =============================================================================

# Snowflake (data lake — requires a schema registry YAML, see schema_examples/)
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=SECURITY_DB
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Okta (identity and authentication logs)
OKTA_DOMAIN=your_org.okta.com
OKTA_API_TOKEN=your_okta_api_token_here

# AWS CloudTrail (requires AWS credentials with read access to CloudTrail)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Wiz (runtime security events)
WIZ_CLIENT_ID=your_wiz_client_id_here
WIZ_CLIENT_SECRET=your_wiz_client_secret_here

# =============================================================================
# Layer 2 — Organizational Knowledge Base
# =============================================================================

# Glean (unified enterprise search — preferred if available)
GLEAN_API_KEY=your_glean_api_key_here
GLEAN_INSTANCE=your_company    # your Glean subdomain

# GitHub (code and change context)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_ORG=your_github_org

# =============================================================================
# Case Management (optional — for ticket creation from case reports)
# =============================================================================

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SEC
